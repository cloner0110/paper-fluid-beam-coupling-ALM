@article{zhang_weak_2014,
	title = {Weak form quadrature element analysis of spatial geometrically exact shear-rigid beams},
	volume = {87},
	issn = {0168-874X},
	url = {https://www.sciencedirect.com/science/article/pii/S0168874X14000699},
