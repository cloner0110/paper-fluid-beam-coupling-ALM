@article{neto_static_2014,
	title = {Static analysis of offshore risers with a geometrically-exact {3D} beam model subjected to unilateral contact},
	volume = {53},
	issn = {1432-0924},
	url = {https://doi.org/10.1007/s00466-013-0897-9},
	doi = {10.1007/s00466-013-0897-9},
	abstract = {In offshore applications there are elements that can be modeled as long beams, such as umbilical cables, flexible and rigid pipes and hoses, immersed in the sea water, suspended from the floating unit to the seabed. The suspended part of these elements is named “riser” and is subjected to the ocean environment loads, such as waves and sea current. This work presents a structural geometrically-exact 3D beam model, discretized using the finite element method for riser modeling. An updated Lagrangian framework for the rotation parameterization has been used for the description of the exact kinematics. The goal is to perform a complete static analysis, considering the oceanic loads and the unilateral contact with the seabed, extending the current standard analysis for situations in which very large rotations occurs, in particular, large torsion. Details of the nonlinear 3D model and loads from oceanic environment are discussed, including the contact unilateral constraint.},
	language = {en},
	number = {1},
	urldate = {2024-08-27},
	journal = {Computational Mechanics},
	author = {Neto, Alfredo Gay and Martins, Clóvis A. and Pimenta, Paulo M.},
	month = jan,
	year = {2014},
	keywords = {Cables, Contact, Finite element, Nonlinear, Riser, Static analysis},
	pages = {125--145},
}

